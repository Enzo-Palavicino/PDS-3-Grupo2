# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca subas tokens ni claves al repositorio (es público).

# Nivel de detalle de los logs: DEBUG, INFO, WARNING o ERROR.
# DEBUG también registra las trazas completas de los errores, que pueden incluir datos de los
# mensajes: úsalo solo en desarrollo, con datos ficticios.
LOG_LEVEL=INFO

# Token del bot de Telegram, entregado por @BotFather. Quien lo tenga controla el bot.
TELEGRAM_BOT_TOKEN=
# off: no recibe mensajes (tests y CI). polling: desarrollo local, sin URL pública.
TELEGRAM_MODE=off

# Base de datos. Por defecto, un archivo SQLite en data/ (ignorada por git).
DATABASE_URL=sqlite:///./data/app.db
# Contraseña de los usuarios de demostración que crea scripts/sembrar_datos.py.
SEED_PASSWORD=

# Transcripción de audios: fake (texto fijo, sin API key) u openai.
# El proveedor de transcripción recibe el audio sin seudonimizar: en producción, usar una cuenta
# sin retención de datos. En desarrollo, solo datos ficticios.
STT_PROVIDER=fake
STT_MODEL=gpt-transcribe
# Carpeta donde se guarda cada audio solo mientras se transcribe. Si no se indica, se usa la
# carpeta temporal del sistema.
# AUDIO_DIR=

# Extracción de los campos con IA: fake (sin IA, deja los campos vacíos) u openai.
LLM_PROVIDER=fake
LLM_MODEL=gpt-6-luna

# API key de OpenAI que entregó el curso. Sirve para STT_PROVIDER=openai y LLM_PROVIDER=openai,
# y solo permite los modelos gpt-6-luna, gpt-transcribe y text-embedding-3-small/large.
# Va solo aquí: nunca la subas al repositorio ni la compartas por chat.
OPENAI_API_KEY=
